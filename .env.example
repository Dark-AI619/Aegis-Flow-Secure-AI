# Copy to .env. Never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Optional Google search enrichment. This is NOT an LLM key.
SERPER_API_KEY=
AEGIS_DB_PATH=data/aegisflow.db
# Hard ceilings shared by both agents in one incident.
AEGIS_MAX_LLM_CALLS=2
AEGIS_MAX_OUTPUT_TOKENS=700
CREWAI_TELEMETRY_DISABLED=true
OTEL_SDK_DISABLED=true
